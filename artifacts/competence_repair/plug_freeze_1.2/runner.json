{
  "seed": 0,
  "num_steps_per_env": 24,
  "max_iterations": 3000,
  "obs_groups": {
    "actor": [
      "proprio",
      "wrist",
      "external"
    ],
    "critic": [
      "critic"
    ]
  },
  "save_interval": 100,
  "experiment_name": "plug_wrist_static",
  "run_name": "",
  "logger": "tensorboard",
  "wandb_project": "mjlab",
  "wandb_tags": [],
  "resume": false,
  "load_run": ".*",
  "load_checkpoint": "model_.*.pt",
  "clip_actions": null,
