  "class_name": "OnPolicyRunner",
  "actor": {
    "hidden_dims": [
      128,
      128
    ],
    "activation": "elu",
    "obs_normalization": true,
    "cnn_cfg": {
      "output_channels": [
        16,
        32
      ],
      "kernel_size": [
        5,
        3
      ],
      "stride": [
        2,
        2
      ],
      "padding": "zeros",
      "activation": "elu",
      "max_pool": false,
      "global_pool": "none",
      "spatial_softmax": true
    },
    "distribution_cfg": {
      "class_name": "GaussianDistribution",
      "init_std": 0.4,
      "std_type": "scalar"
    },
    "rnn_type": "gru",
    "rnn_hidden_dim": 128,
    "rnn_num_layers": 1,
    "class_name": "active_perception_arms.visual_target_policy:DenseVisualTargetPolicy",
    "episode_seconds": 8,
    "inspection_end": 1.2
  },
  "critic": {
    "hidden_dims": [
      128,
      128
    ],
    "activation": "elu",
    "obs_normalization": true,
    "cnn_cfg": null,
    "distribution_cfg": null,
