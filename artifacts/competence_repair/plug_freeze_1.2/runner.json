  },
  "algorithm": {
    "num_learning_epochs": 4,
    "num_mini_batches": 8,
    "learning_rate": 0.0003,
    "schedule": "adaptive",
    "gamma": 0.99,
    "lam": 0.95,
    "entropy_coef": 0.003,
    "desired_kl": 0.01,
    "max_grad_norm": 1.0,
    "value_loss_coef": 1.0,
    "use_clipped_value_loss": true,
    "clip_param": 0.2,
    "normalize_advantage_per_mini_batch": false,
