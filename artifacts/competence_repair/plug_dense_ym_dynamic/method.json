{
  "method": "supervised visual target estimation with prescribed lift-align-descend",
  "teacher": "privileged target labels during training only; actor uses RGB/proprio and a time-based motion plan",
  "actor_inputs": [
    "wrist RGB",
    "external RGB",
    "proprioception"
  ],
  "args": {
    "output": "artifacts/competence_repair/plug_dense_ym_dynamic",
    "variant": "ym",
    "steps": 8000,
    "num_envs": 256,
    "horizon": 8,
    "clearance": 0.002,
    "seed": 0,
    "teacher_only": false,
    "jitter": 0.008,
    "occlusion": "dynamic",
    "eval_dynamic": true,
    "learning_rate": 3e-05,
    "dense": true,
    "inspection_only": false,
    "visual_data_only": false,
    "factorized": false,
    "initialize_actor": "artifacts/competence_repair/plug_dense_ym/model_6000.pt",
    "eval_interval": 2000
  }
}